# ==============================================================================
# KAZE OS: USER BASH CONFIGURATION (~/.bashrc)
# ==============================================================================

alias ls='ls --color=auto'
alias ll='ls -lah --color=auto'
alias grep='grep --color=auto'
alias kaze='kaze-cli'

PS1='\[\033[01;36m\]\u@kaze\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
