/* ==========================================================================
   KAZE OS: CALAMARES STYLESHEET (Dark & Vibrant Modern Theme)
   ========================================================================== */

QWidget {
    background-color: #1a1b26;
    color: #c0caf5;
    font-family: "Noto Sans", sans-serif;
    font-size: 13px;
}

QDialog, QMainWindow {
    background-color: #1a1b26;
}

QTreeView, QListView, QTableView {
    background-color: #16161e;
    alternate-background-color: #1a1b26;
    border: 1px solid #292e42;
    border-radius: 6px;
    padding: 4px;
}

QPushButton {
    background-color: #24283b;
    border: 1px solid #414868;
    border-radius: 6px;
    padding: 8px 18px;
    font-weight: bold;
    color: #c0caf5;
}

QPushButton:hover {
    background-color: #7aa2f7;
    color: #15161e;
    border-color: #7aa2f7;
}

QPushButton:pressed {
    background-color: #bb9af7;
    color: #15161e;
}

QPushButton:disabled {
    background-color: #1f2335;
    color: #565f89;
    border-color: #292e42;
}

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #16161e;
    border: 1px solid #414868;
    border-radius: 6px;
    padding: 6px;
    color: #c0caf5;
}

QLineEdit:focus, QTextEdit:focus {
    border: 1px solid #7aa2f7;
}

QProgressBar {
    background-color: #16161e;
    border: 1px solid #292e42;
    border-radius: 6px;
    text-align: center;
    color: #ffffff;
    font-weight: bold;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #7aa2f7, stop:1 #bb9af7);
    border-radius: 5px;
}

QComboBox {
    background-color: #24283b;
    border: 1px solid #414868;
    border-radius: 6px;
    padding: 5px 12px;
    color: #c0caf5;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #414868;
}

QCheckBox, QRadioButton {
    spacing: 8px;
    color: #c0caf5;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid #414868;
    background-color: #16161e;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #7aa2f7;
    border-color: #7aa2f7;
}
