# ==============================================================================
# KAZE OS: CALAMARES BASE BRANDING (core/calamares/branding/default/branding.desc)
# ==============================================================================

---
componentName: default

windowExpanding: noexpand
windowSize: 960px,640px
windowPlacement: center

strings:
    productName:         "Kaze OS"
    shortProductName:    "Kaze"
    version:             "1.0.0"
    shortVersion:        "1.0"
    versionedName:       "Kaze OS 1.0.0 (風)"
    shortVersionedName:  "Kaze 1.0"
    bootloaderEntryName: "Kaze OS"
    productUrl:          "https://github.com/devpryan7792/arch-distro"
    supportUrl:          "https://github.com/devpryan7792/arch-distro/issues"
    knownIssuesUrl:      "https://github.com/devpryan7792/arch-distro/issues"
    releaseNotesUrl:     "https://github.com/devpryan7792/arch-distro/releases"

images:
    productLogo:         "kaze-logo.png"
    productIcon:         "kaze-logo.png"
    productWelcome:      "welcome.png"

style:
    SidebarBackground:    "#12121e"
    SidebarText:          "#e0e0ff"
    SidebarTextSelect:    "#ffffff"
    SidebarTextHighlight: "#7aa2f7"

slideshow:               "show.qml"

slideshowAPI: 2
